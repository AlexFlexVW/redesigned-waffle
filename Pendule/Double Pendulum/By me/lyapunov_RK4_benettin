# GESTION DES FICHIERS
# ==========================================
output_dir = Path(r"C:\Users\vanwa\Documents\VSCode Local\resultat_code\Pendule_double\RK4\lyapunov_exposant")

if not output_dir.exists():
    raise FileNotFoundError(
        f"\n[ERREUR] Le dossier cible n'existe pas :\n'{output_dir}'\n"
        "Veuillez le créer manuellement avant de lancer le script."
    )

# ==========================================
# AFFICHAGES GRAPHIQUES
# ==========================================

# --- Graphique 1 : λ(t) pour une condition initiale fixe ---
print("Calcul graphique 1 : λ(t) pour theta = (pi/2, pi/2) avec RK4...")
iterations = np.arange(n)

mle_res = calcul_lyapunov_RK4(theta0, omega0)

fig1 = plt.figure(figsize=(10, 5))
# Titre propre et bien espacé
titre_1 = (f"Pendule double — RK4 — Perturbation ε={epsilon} sur θ₁(0)\n"
              f"(θ₁₀ = {th1_0:.3f}, θ₂₀ = {th2_0:.3f})")
fig1.suptitle(titre_1, fontsize=16)

plt.plot(iterations, mle_res, linewidth=0.8, color='tab:blue')
plt.xlabel("Itérations")
plt.ylabel("Exposant de Lyapunov $\\lambda$")
plt.axhline(y=mle_res[-1], color='r', linestyle='--', label=f'MLE = {mle_res[-1]:.4f}')
plt.grid(True, alpha=0.3)
plt.legend()
plt.tight_layout()
fig1.subplots_adjust(top=0.88) # Laisse l'espace pour le Suptitle

# Sauvegarde Graphique 1
nom_fig1 = f"lyapunov_convergence_RK4_th1_{th1_0:.2f}_th2_{th2_0:.2f}.png"
chemin_fig1 = output_dir / nom_fig1
plt.savefig(chemin_fig1, bbox_inches='tight', dpi=300)
print(f"Graphique 1 sauvegardé : {nom_fig1}")
plt.show()


# --- Graphique 2 : λ final en fonction de θ2_0 ---
print("\nCalcul graphique 2 : Lyapunov en fonction de θ2_0 (Cela va prendre un peu de temps avec RK4)...")
theta2_values = np.linspace(0.1, np.pi, 25) 
lyapunov_exponents = np.zeros_like(theta2_values)

for idx, th2_val in enumerate(theta2_values):
    lyap_exp = calcul_lyapunov_RK4([th1_0, th2_val], omega0)[-1]
    lyapunov_exponents[idx] = lyap_exp
    
    # Barre de progression
    if (idx + 1) % 5 == 0:
        print(f"  Progression: {idx + 1}/{len(theta2_values)}")

fig2 = plt.figure(figsize=(10, 6))
titre_2 = (f"Exposant de Lyapunov final en fonction de l'angle initial (RK4)\n"
           f"$\\theta_1$ fixé à {th1_0:.2f} rad")
fig2.suptitle(titre_2, fontsize=16)

plt.plot(theta2_values, lyapunov_exponents, 'o-', linewidth=2, markersize=6, color='purple')
plt.xlabel(f"Angle initial $\\theta_2$ (rad)")
plt.ylabel("Exposant de Lyapunov $\\lambda$")
plt.grid(True, alpha=0.3)
plt.tight_layout()
fig2.subplots_adjust(top=0.88)

# Sauvegarde Graphique 2
nom_fig2 = f"lyapunov_th2_RK4_th1_{th1_0:.2f}.png"
chemin_fig2 = output_dir / nom_fig2
plt.savefig(chemin_fig2, bbox_inches='tight', dpi=300)
print(f"Graphique 2 sauvegardé : {nom_fig2}")

plt.show()

print("\nSimulations terminées avec succès !")