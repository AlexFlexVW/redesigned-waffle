# 2. GRAPHIQUE DE L'ÉNERGIE MÉCANIQUE (ZOOM)
plt.figure(figsize=(9, 5))
plt.plot(t, E_total, label='E totale', linewidth=1.5, color='red')
plt.xlabel('Temps (s)')
plt.ylabel('Énergie adimensionnelle E/(mgl)')
plt.title(fr"Conservation de l'énergie mécanique — RK4 ({label_titre})")
plt.legend()
plt.grid(True)
nom_fichier_energie_mec = f"energy_mec_plot_pd_RK4_NL_{label_fichier}.png"
energy_tot_path = output_dir / nom_fichier_energie_mec
