        f"\n[ERREUR] Le dossier cible n'existe pas :\n'{output_dir}'\n"
        "Veuillez le créer manuellement avant de lancer le script."
    )

# Noms de base avec les conditions initiales
label_titre = fr"$\theta_1={theta1_0}, \theta_2={theta2_0}$"
label_fichier = f"th1={theta1_0}_th2={theta2_0}"


# 1. GRAPHIQUE DES ANGLES
plt.figure(figsize=(9, 5))
plt.plot(t, theta[:, 0], label=r'$\theta_1$ (RK4 NL)')
plt.plot(t, theta[:, 1], label=r'$\theta_2$ (RK4 NL)')
plt.xlabel('Temps (s)')
plt.ylabel('Angle (rad)')
plt.title(fr'Double Pendule — RK4 ({label_titre})')
plt.legend()
plt.grid(True)
nom_fichier_angle = f"angle_plot_pd_RK4_NL_{label_fichier}.png"
