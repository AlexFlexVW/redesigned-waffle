import numpy as np
import matplotlib.pyplot as plt
from pathlib import Path

# Paramètres globaux d'affichage
plt.rcParams.update({'font.size': 14})

# --- Paramètres Physiques  ---
g = 9.81 
l = 0.25 

# --- Paramètres Numériques ---
dt = 0.0001 
n = int(1e5)

# Conditions initiales
epsilon = 1e-6  # Perturbation initiale
th1_0 = np.pi/2
th2_0 = np.pi/2
theta0 = [th1_0, th2_0]
omega0 = [0.0, 0.0]

def ddtheta(th1, th2, w1, w2):
    """
    Calcule les accélérations du pendule double.
    """
    delta = th1 - th2
    sin_d, cos_d = np.sin(delta), np.cos(delta)
    det = 2 - cos_d**2 
    
    b1 = -(w2**2) * sin_d - 2 * (g/l) * np.sin(th1) 
    b2 = (w1**2) * sin_d - (g/l) * np.sin(th2) 
    
    d2th1 = (b1 - cos_d * b2) / det 
    d2th2 = (2 * b2 - cos_d * b1) / det 
    
    return d2th1, d2th2

def calcul_lyapunov_Euler(theta_init, omega_init):
    """
    Calcule l'exposant de Lyapunov max via l'algorithme de Benettin avec Euler semi-implicite.
    """
    # Y = [theta1, theta2, omega1, omega2]
    Y1 = np.array([theta_init[0], theta_init[1], omega_init[0], omega_init[1]])
    
    # Trajectoire 2 décalée de epsilon sur theta1
    Y2 = np.array([theta_init[0] + epsilon, theta_init[1], omega_init[0], omega_init[1]])

    lyap_sum = 0
    lambda_t = np.zeros(n)

    for i in range(n-1):
        # 1. Évolution Trajectoire 1 (Euler semi-implicite)
        d2th1_1, d2th2_1 = ddtheta(Y1[0], Y1[1], Y1[2], Y1[3])
        # On calcule d'abord les nouvelles vitesses
        w1_next_1 = Y1[2] + d2th1_1 * dt
        w2_next_1 = Y1[3] + d2th2_1 * dt
        # Puis les nouvelles positions avec ces nouvelles vitesses
        th1_next_1 = Y1[0] + w1_next_1 * dt
        th2_next_1 = Y1[1] + w2_next_1 * dt

        # 2. Évolution Trajectoire 2 (Euler semi-implicite)
        d2th1_2, d2th2_2 = ddtheta(Y2[0], Y2[1], Y2[2], Y2[3])
        w1_next_2 = Y2[2] + d2th1_2 * dt
        w2_next_2 = Y2[3] + d2th2_2 * dt
        th1_next_2 = Y2[0] + w1_next_2 * dt
        th2_next_2 = Y2[1] + w2_next_2 * dt

        # 3. Calcul de la distance 4D (avec modulo sur les angles pour éviter les sauts de 2pi)
        diff_th1 = (th1_next_2 - th1_next_1 + np.pi) % (2 * np.pi) - np.pi
        diff_th2 = (th2_next_2 - th2_next_1 + np.pi) % (2 * np.pi) - np.pi
        diff_w1 = w1_next_2 - w1_next_1
        diff_w2 = w2_next_2 - w2_next_1

        dist = np.sqrt(diff_th1**2 + diff_th2**2 + diff_w1**2 + diff_w2**2)

        # Accumulation du taux de séparation
        lyap_sum += np.log(dist / epsilon)
        
        # Renormalisation (On ramène Y2 à la distance epsilon de Y1)
        th1_final_2 = th1_next_1 + (epsilon / dist) * diff_th1
        th2_final_2 = th2_next_1 + (epsilon / dist) * diff_th2
        w1_final_2  = w1_next_1 + (epsilon / dist) * diff_w1
        w2_final_2  = w2_next_1 + (epsilon / dist) * diff_w2

        # Mise à jour pour l'itération suivante
        Y1 = np.array([th1_next_1, th2_next_1, w1_next_1, w2_next_1])
        Y2 = np.array([th1_final_2, th2_final_2, w1_final_2, w2_final_2])
        
        lambda_t[i+1] = lyap_sum / ((i+1) * dt)

    return lambda_t


# ==========================================
# GESTION DES FICHIERS
# ==========================================
output_dir = Path(r"C:\Users\vanwa\Documents\VSCode Local\resultat_code\Pendule_double\euler\lyapunov exposant")

if not output_dir.exists():
    raise FileNotFoundError(
        f"\n[ERREUR] Le dossier cible n'existe pas :\n'{output_dir}'\n"
        "Veuillez le créer manuellement avant de lancer le script."
    )

# ==========================================
# AFFICHAGES GRAPHIQUES
# ==========================================

# --- Graphique 1 : λ(t) pour une condition initiale fixe ---
print("Calcul graphique 1 : λ(t) pour theta = (pi/2, pi/2) avec Euler semi-implicite...")
iterations = np.arange(n)

mle_res = calcul_lyapunov_Euler(theta0, omega0)

fig1 = plt.figure(figsize=(10, 5))
# Titre propre et harmonisé (sans le gras forcé)
titre_1 = (f"Exposant de Lyapunov - Euler semi-implicite\n"
           f"$\\theta_1={th1_0:.2f}$ rad, $\\theta_2={th2_0:.2f}$ rad")
fig1.suptitle(titre_1, fontsize=16)

plt.plot(iterations, mle_res, linewidth=0.8, color='tab:blue')
plt.xlabel("Itérations")
plt.ylabel("Exposant de Lyapunov $\\lambda$")
plt.axhline(y=mle_res[-1], color='r', linestyle='--', label=f'MLE = {mle_res[-1]:.4f}')
plt.grid(True, alpha=0.3)
plt.legend()
plt.tight_layout()
fig1.subplots_adjust(top=0.88) # Laisse respirer le Suptitle

# Sauvegarde Graphique 1
nom_fig1 = f"lyapunov_convergence_Euler_th1_{th1_0:.2f}_th2_{th2_0:.2f}.png"
chemin_fig1 = output_dir / nom_fig1
plt.savefig(chemin_fig1, bbox_inches='tight', dpi=300)
print(f"Graphique 1 sauvegardé : {nom_fig1}")
plt.show()


# --- Graphique 2 : λ final en fonction de θ2_0 ---
print("\nCalcul graphique 2 : Lyapunov en fonction de θ2_0 (Balayage paramétrique)...")
theta2_values = np.linspace(0.1, np.pi, 25) 
lyapunov_exponents = np.zeros_like(theta2_values)

for idx, th2_val in enumerate(theta2_values):
    lyap_exp = calcul_lyapunov_Euler([th1_0, th2_val], omega0)[-1]
    lyapunov_exponents[idx] = lyap_exp
    
    # Barre de progression
    if (idx + 1) % 5 == 0:
        print(f"  Progression: {idx + 1}/{len(theta2_values)}")

fig2 = plt.figure(figsize=(10, 6))
titre_2 = (f"MLE en fonction de l'angle initial - Euler\n"
           f"$\\theta_1$ fixé à {th1_0:.2f} rad")
fig2.suptitle(titre_2, fontsize=16)

plt.plot(theta2_values, lyapunov_exponents, 'o-', linewidth=2, markersize=6, color='purple')
plt.xlabel(f"Angle initial $\\theta_2$ (rad)")
plt.ylabel("Exposant de Lyapunov $\\lambda$")
plt.grid(True, alpha=0.3)
plt.tight_layout()
fig2.subplots_adjust(top=0.88)

# Sauvegarde Graphique 2
nom_fig2 = f"lyapunov_vs_th2_Euler_th1_{th1_0:.2f}.png"
chemin_fig2 = output_dir / nom_fig2
plt.savefig(chemin_fig2, bbox_inches='tight', dpi=300)
print(f"Graphique 2 sauvegardé : {nom_fig2}")

plt.show()

print("\nSimulations terminées avec succès !")