# --- Graphique 1 : lambda(t) pour un theta0 donné ---
print("Calcul graphique 1: lambda(i) pour theta0 = 0.5 rad (RK4)...")
lambda_array, lyapunov_exponent = mle_benettin_RK4(theta0_fixe, omega0_fixe, n)
iterations = np.arange(n)

fig1, ax1 = plt.subplots(figsize=(10, 6))
titre_1 = (f"Convergence de l'exposant de Lyapunov - RK4\n"
           f"Pendule simple — $\\theta_0={theta0_fixe}$ rad")
fig1.suptitle(titre_1, fontsize=16)

ax1.plot(iterations, lambda_array, linewidth=0.7, color='tab:blue')
ax1.set_xlabel("Itération i")
ax1.set_ylabel("Exposant de Lyapunov $\\lambda$")
ax1.grid(True, alpha=0.3)
ax1.axhline(y=lyapunov_exponent, color='r', linestyle='--', label=f'MLE: {lyapunov_exponent:.6f}')
ax1.axhline(y=0, color='k', linestyle=':', alpha=0.5, label='λ = 0 (théorique)')
ax1.legend()

plt.tight_layout()
fig1.subplots_adjust(top=0.88)
chemin_fig1 = output_dir / f"lyapunov_cvg_RK4_ps_th0_{theta0_fixe:.2f}.png"
plt.savefig(chemin_fig1, bbox_inches='tight', dpi=300)
print(f"Graphique 1 sauvegardé : {chemin_fig1.name}")
plt.show()


# --- Graphique 2 : lambda en fonction de theta0 ---
print("\nCalcul graphique 2: Lyapunov exponent en fonction de θ₀ (RK4)...")
theta0_values = np.linspace(0.01, np.pi/2, 30)
lyapunov_exponents = np.zeros_like(theta0_values)

for idx, th0 in enumerate(theta0_values):
    _, lyap_exp = mle_benettin_RK4(th0, omega0_fixe, n)
    lyapunov_exponents[idx] = lyap_exp
    if (idx + 1) % 10 == 0:
        print(f"  Progression: {idx + 1}/{len(theta0_values)}")

fig2, ax2 = plt.subplots(figsize=(10, 6))
titre_2 = (f"MLE en fonction de $\\theta_0$ (RK4)\n"
           f"Pendule simple — $n = {dom_n}e{p_n}$, $T_{{renorm}} = {T_renorm}$")
fig2.suptitle(titre_2, fontsize=16)

ax2.plot(theta0_values, lyapunov_exponents, 'o-', linewidth=2, markersize=6, color='purple')
ax2.axhline(y=0, color='k', linestyle=':', alpha=0.5, label='λ = 0 (théorique)')
ax2.set_xlabel("Angle initial $\\theta_0$ (rad)")
ax2.set_ylabel("Exposant de Lyapunov $\\lambda$")
ax2.grid(True, alpha=0.3)
ax2.legend()

plt.tight_layout()
fig2.subplots_adjust(top=0.88)
nom_fig2=f"lyapunov_eps={epsilon}_th0={theta0_fixe}_rk4.png"
chemin_fig2 = output_dir / "lyapunov_th0_RK4.png"
plt.savefig(chemin_fig2, bbox_inches='tight', dpi=300)
print(f"Graphique 2 sauvegardé : {chemin_fig2.name}")
plt.show()