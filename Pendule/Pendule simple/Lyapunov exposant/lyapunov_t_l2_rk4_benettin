import numpy as np
import matplotlib.pyplot as plt
from pathlib import Path
from numba import njit

# Paramètres globaux d'affichage
plt.rcParams.update({'font.size': 14})

# Paramètres physiques
g = 9.81
l = 0.25
w0 = np.sqrt(g/l)

# Paramètres numériques
dom_n = 1
p_n = 6
dt = 0.0001
n = int(dom_n * 10**p_n)

# Conditions initiales
theta0_fixe = 0.5
omega0_fixe = 0.0

# Perturbation et renormalisation
epsilon = 1e-6
T_renorm = 500

# Numba va compiler cette fonction mathématique à la vitesse de l'éclair
@njit
def deriv_ps(state):
    """
    Dérivée pour le pendule simple (RK4).
    state = [theta, omega]
    """
    th, om = state
    return np.array([om, -w0**2 * np.sin(th)])

@njit
def mle_benettin_RK4(theta0, omega0, n_iter):
    """
    Calcule l'exposant de Lyapunov par la méthode de Benettin avec RK4.
    """
    Y1 = np.array([theta0, omega0])
    Y2 = np.array([theta0 + epsilon, omega0])

    lambda_array = np.zeros(n_iter)
    sum_log = 0.0
    t = 0.0

    for i in range(n_iter - 1):
        # RK4 pour Trajectoire 1
        k1_1 = deriv_ps(Y1)
        k2_1 = deriv_ps(Y1 + 0.5 * dt * k1_1)
        k3_1 = deriv_ps(Y1 + 0.5 * dt * k2_1)
        k4_1 = deriv_ps(Y1 + dt * k3_1)
        Y1 = Y1 + (dt / 6.0) * (k1_1 + 2 * k2_1 + 2 * k3_1 + k4_1)

        # RK4 pour Trajectoire 2
        k1_2 = deriv_ps(Y2)
        k2_2 = deriv_ps(Y2 + 0.5 * dt * k1_2)
        k3_2 = deriv_ps(Y2 + 0.5 * dt * k2_2)
        k4_2 = deriv_ps(Y2 + dt * k3_2)
        Y2 = Y2 + (dt / 6.0) * (k1_2 + 2 * k2_2 + 2 * k3_2 + k4_2)

        t += dt

        # Renormalisation périodique
        if (i + 1) % T_renorm == 0:
            dth = (Y2[0] - Y1[0] + np.pi) % (2 * np.pi) - np.pi
            dom = Y2[1] - Y1[1]
            d = np.sqrt(dth**2 + dom**2)

            if d > 0:
                sum_log += np.log(d / epsilon)
                factor = epsilon / d
                Y2[0] = Y1[0] + dth * factor
                Y2[1] = Y1[1] + dom * factor

            lambda_array[i+1] = sum_log / t
        else:
            lambda_array[i+1] = lambda_array[i]

    lyapunov_exponent = sum_log / (n_iter * dt)
    return lambda_array, lyapunov_exponent


