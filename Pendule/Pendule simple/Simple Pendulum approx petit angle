import numpy as np
import matplotlib.pyplot as plt

# Paramètres physiques
g = 9.81          # gravité (m/s^2)
l = 0.25          # longueur du pendule (m)
m = 1.0           # masse (kg) — choix arbitraire pour les énergies
w0 = np.sqrt(g / l)  # pulsation

# Paramètres numériques
dt = 0.0001        # pas temporel (s)
n = 100000         # nombre d'itérations

# Conditions initiales (petits angles : en radians)
theta0 = 1.0      # angle initial (rad)
omega0 = 0.0      # vitesse angulaire initiale (rad/s)

# Stockage
theta = np.zeros(n)
omega = np.zeros(n)
t = np.zeros(n)

theta[0] = theta0
omega[0] = omega0

# Intégration par Euler explicite (approx. petit angle)
for i in range(n - 1):
    omega[i + 1] = omega[i] - w0**2 * theta[i] * dt
    theta[i + 1] = theta[i] + omega[i + 1] * dt
    t[i + 1] = t[i] + dt

# Calcul des énergies
# Energie cinétique: Ec = 1/2 m (l * theta_dot)^2
# Energie potentielle: Ep = m g l (1 - cos(theta))  (choix exact, pas l'approx quadratique)
Ec = 0.5 * m * (l * omega) ** 2
Ep = (m * g * l * (theta)**2)/2
E = Ec + Ep

# Tracé: angles (en haut) et énergies (en bas) dans la même figure
fig, (ax1, ax2) = plt.subplots(2, 1, sharex=True, figsize=(9, 6))

# Angles: numérique vs solution théorique (petit angle)
ax1.plot(t, theta, label='Euler numérique')
ax1.plot(t, theta0 * np.cos(w0 * t), label='Théorique (cos)', linestyle='--')
ax1.set_ylabel('Angle (rad)')
ax1.set_title('Pendule simple — Euler explicite (petit angle)')
ax1.legend()
ax1.grid(True)

# Energies
ax2.plot(t, Ec, label='Energie cinétique (J)')
ax2.plot(t, Ep, label='Energie potentielle (J)')
ax2.plot(t, E,  label='Energie mécanique (J)', linewidth=1.5)
ax2.set_xlabel('Temps (s)')
ax2.set_ylabel('Energie (J)')
ax2.legend()
ax2.grid(True)

plt.tight_layout()
plt.show()
