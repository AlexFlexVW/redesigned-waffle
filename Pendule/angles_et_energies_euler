plt.figure(figsize=(9, 5))
plt.plot(t, theta[:, 0], label=r'$\theta_1$')
plt.plot(t, theta[:, 1], label=r'$\theta_2$')
plt.xlabel('Temps (s)')
plt.ylabel('Angle (rad)')
plt.title(fr'Angles Pendule Double — Euler Symplectique ($\theta_1={theta1_0}, \theta_2={theta2_0}$)')
