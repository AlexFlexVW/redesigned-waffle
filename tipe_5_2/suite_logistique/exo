def bifucartion(nmin,nmax,epsilon):
    result=[]
    i=0
    while i*epsilon<=r:
        l=liste_suite(i*epsilon,nmin,nmax)
        result.append([(i*epsilon,l[j]) for j in range(nmax-nmin)])
        i+=1
    return result

def exposant_lyapunov(liste_u,r):
    n=len(liste_u)
    somme=0
    if r>0:
        for i in range(n):
            u_n = liste_u[i][1]
            if u_n!=0.5:
                somme+=np.log(r*abs(1-2*u_n))
        return float(somme/n)
    return np.nan

