def choix_couleur(l):
    i = round(150*l)
    R,V,B = i,0,0 # Nuances de rouge
    couleur = '#%02x%02x%02x' % (R%256, V%256, B%256)
    return couleur
def choix_couleur_rgb(l):
    """
    Convertit l'exposant l en un triplet RGB (Rouge, Vert, Bleu) entre 0 et 255.
    Reprend exactement la logique de l'énoncé : i = round(150 * l) % 256.
    """
    i = round(150 * l)
    R = i % 256
    V = 0
    B = 0
    return (R, V, B)
N=100
def fractale_lyapunov(motif, N=100, nmin=100, nmax=200):
    image = np.zeros((N, N, 3), dtype=np.uint8)
    r1=0.0
    h=4.0/N
    for i in range(N):
        r2=0.0
        for j in range(N):
            l=exposant_lyapunov_motif(r1,r2,motif,nmin,nmax)
            image[N - 1 - j, i] = choix_couleur_rgb(l)
            r2+=h
        r1+=h
        # Affichage de la progression dans le terminal tous les 10%
        if (i + 1) % max(1, (N // 10)) == 0:
            print(f"Progression : {int((i + 1) / N * 100)}%")

    # --- GESTION DU DOSSIER ET SAUVEGARDE ---
