def A_ou_B(motif,n):
    r=n % len(motif)
    return motif[r]
assert(A_ou_B('AB',10)=='A')
assert(A_ou_B('AABA',10)=='B')

def exposant_lyapunov_motif(r1,r2,motif,nmin,nmax,u0=0.5):
    if r1 == 0 or r2 == 0:
        return -10.0  # Valeur arbitraire très négative (stable)
    l=[u0]
    somme=0
    for i in range (1,nmax):
        if A_ou_B(motif,i-1)=='A':
            r=r1
        else:
            r=r2

        u=r*l[i-1]*(1-l[i-1])
        if i>=nmin and l[i-1]!=0.5:
            somme+=np.log(r*abs(1-2*l[i-1]))
           
        l.append(u)
        
    return float(somme/(nmax-nmin))
