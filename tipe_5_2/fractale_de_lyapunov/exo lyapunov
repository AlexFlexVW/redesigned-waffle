def liste_suite(r,nmin,nmax):
    l=[u0]
    result=[]
    for i in range (nmax):
        if i==0 and nmin==0:result.append(0.5)
        else:
            u=r*l[i-1]*(1-l[i-1])
            l.append(u)
            if i>=nmin:
                result.append(u)
    return result
'''Par exemple liste_suite(1.5,0,5) renvoie les 5 premiers termes de la suite définie par le
paramètre r = 1.5 : [0.5, 0.375, 0.35156 . . . , 0.34194 . . . , 0.33753 . . .].'''
